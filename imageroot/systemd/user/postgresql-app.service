[Unit]
Description=Podman postgresql-app.service
BindsTo=keycloak.service
After=keycloak.service
Before=keycloak-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# POSTGRES_PASSWORD, generated by create-module (secret, mode 0600)
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
TimeoutStartSec=180
ExecStartPre=/bin/rm -f %t/postgresql-app.pid %t/postgresql-app.ctr-id
# POSTGRES_PASSWORD has no value: it is passed through from the unit environment
ExecStart=/usr/bin/podman run --conmon-pidfile %t/postgresql-app.pid \
    --cidfile %t/postgresql-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/keycloak.pod-id --replace -d --name postgresql-app \
    --volume postgres-data:/var/lib/postgresql:Z \
    --env=POSTGRES_USER=keycloak \
    --env=POSTGRES_DB=keycloak \
    --env=POSTGRES_PASSWORD \
    --env=TZ=UTC \
    ${POSTGRES_IMAGE}
# Wait for the TCP socket: during the first initialization the temporary
# server only listens on the Unix socket
ExecStartPost=/usr/bin/bash -c "until podman exec postgresql-app pg_isready -q -h 127.0.0.1 -U keycloak -d keycloak; do sleep 2; done"
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/postgresql-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/postgresql-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/postgresql-app.pid
Type=forking

[Install]
WantedBy=default.target
