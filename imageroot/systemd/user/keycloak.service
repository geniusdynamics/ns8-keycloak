#
# This systemd unit starts the keycloak pod using Podman. The pod holds
# the PostgreSQL and the Keycloak containers.
#

[Unit]
Description=Podman keycloak.service
Requires=postgresql-app.service keycloak-app.service
Before=postgresql-app.service keycloak-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/keycloak.pid %t/keycloak.pod-id
# Keycloak serves HTTP on port 8080 behind Traefik, which terminates TLS
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/keycloak.pid \
    --pod-id-file %t/keycloak.pod-id \
    --name keycloak \
    --publish 127.0.0.1:${TCP_PORT}:8080 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/keycloak.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/keycloak.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/keycloak.pod-id
PIDFile=%t/keycloak.pid
Type=forking

[Install]
WantedBy=default.target
