[Unit]
Description=Podman keycloak-app.service
BindsTo=keycloak.service
After=keycloak.service postgresql-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# KC_DB_PASSWORD and KC_BOOTSTRAP_ADMIN_PASSWORD, generated by create-module
# (secrets, mode 0600)
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/keycloak-app.pid %t/keycloak-app.ctr-id
# Variables without a value are passed through from the unit environment.
# TLS is terminated by Traefik, which sets the X-Forwarded-* headers.
# The management interface (health endpoints) listens on port 9000 inside
# the pod and is not published.
ExecStart=/usr/bin/podman run --conmon-pidfile %t/keycloak-app.pid \
    --cidfile %t/keycloak-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/keycloak.pod-id --replace -d --name keycloak-app \
    --env=KC_DB=postgres \
    --env=KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak \
    --env=KC_DB_USERNAME=keycloak \
    --env=KC_DB_PASSWORD \
    --env=KC_HOSTNAME=https://${TRAEFIK_HOST} \
    --env=KC_HTTP_ENABLED=true \
    --env=KC_PROXY_HEADERS=xforwarded \
    --env=KC_HEALTH_ENABLED=true \
    --env=KC_BOOTSTRAP_ADMIN_USERNAME=admin \
    --env=KC_BOOTSTRAP_ADMIN_PASSWORD \
    ${KEYCLOAK_IMAGE} start
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/keycloak-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/keycloak-app.ctr-id
SyslogIdentifier=%u
PIDFile=%t/keycloak-app.pid
Type=forking

[Install]
WantedBy=default.target
