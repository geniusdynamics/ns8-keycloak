import os
import secrets

# Secrets must not go through agent.set_env(), which stores values in
# Redis: keep them in a private file, included in the module backup (see
# etc/state-include.conf) and loaded by the systemd units.
#
# - POSTGRES_PASSWORD and KC_DB_PASSWORD are the same value: the first
#   initializes the PostgreSQL role, the second is used by Keycloak.
# - KC_BOOTSTRAP_ADMIN_PASSWORD is the password of the temporary "admin"
#   user created by Keycloak at its first start only.
db_password = secrets.token_hex(24)
path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    fp.write(f"POSTGRES_PASSWORD={db_password}\n")
    fp.write(f"KC_DB_PASSWORD={db_password}\n")
    fp.write(f"KC_BOOTSTRAP_ADMIN_PASSWORD={secrets.token_hex(16)}\n")
