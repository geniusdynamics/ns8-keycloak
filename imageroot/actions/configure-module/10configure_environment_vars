import json
import sys

import agent

data = json.load(sys.stdin)

# Non-secret settings only: they are stored in Redis by agent.set_env().
# The hostname is read by keycloak.service to compute KC_HOSTNAME.
agent.set_env("TRAEFIK_HOST", data["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", data.get("http2https", True))
agent.set_env("TRAEFIK_LETS_ENCRYPT", data.get("lets_encrypt", False))
agent.dump_env()
