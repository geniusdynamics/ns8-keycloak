import json
import os
import sys

from keycloak_oidc import enabled, validation

if enabled():
    request = json.load(sys.stdin)
    if request["host"] != os.environ.get("TRAEFIK_HOST"):
        validation("host", request["host"], "disable_ns8_sso_first")
    if request.get("http2https", True) is False:
        validation("http2https", False, "disable_ns8_sso_first")
