import json
import os
import sys

import agent

request = json.load(sys.stdin)
renv = request["environment"]

# Pass ALL the settings accepted by configure-module
configure_retval = agent.tasks.run(
    agent_id=os.environ["AGENT_ID"],
    action="configure-module",
    data={
        "host": renv["TRAEFIK_HOST"],
        "http2https": renv["TRAEFIK_HTTP2HTTPS"] == "True",
        "lets_encrypt": renv["TRAEFIK_LETS_ENCRYPT"] == "True",
    },
)
agent.assert_exp(
    configure_retval["exit_code"] == 0, "The configure-module subtask failed!"
)
