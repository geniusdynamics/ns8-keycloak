set -e

if ! systemctl --user -q is-active postgresql-app.service; then
    echo "postgresql-app.service is not running: cannot dump the database" 1>&2
    exit 1
fi

echo "Dumping keycloak postgres database" 1>&2
podman exec postgresql-app pg_dump -U keycloak --format=c keycloak >keycloak.pg_dump
